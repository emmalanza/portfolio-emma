---
const { class: className, id} = Astro.props;
import "aos/dist/aos.css"; 
---

<section id={id} class=`w-full mx-auto px-4 md:px-8 lg:px-12 lg:w-[740px] ${className}`
data-aos="slide-up" data-aos-once="false" data-aos-delay="150">
    <script>
        import { aosInit } from "../js/aos";
        aosInit();
        document.addEventListener("astro:after-swap", aosInit);
    </script>
    <slot />
</section>