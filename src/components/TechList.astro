
---
import TechItem from './TechItem.astro';

const TECHNOLOGIES = [
    {
         title: "HTML",
         icon: "/svg/tech/html5.svg"
    },
    {
         title: "CSS",
         icon: "/svg/tech/css.svg"
    },
    {
         title: "JAVASCRIPT",
         icon: "/svg/tech/javascript.svg"
    },
    {
         title: "TYPESCRIPT",
         icon: "/svg/tech/typescript.svg"
    },
    {
         title: "ASTRO",
         icon: "/svg/tech/astro.svg"
    },
    {
         title: "REACT",
         icon: "/svg/tech/react.svg"
    },
    {
         title: "TAILWINDCSS",
         icon: "/svg/tech/tailwindcss.svg"
    },
    {
         title: "MYSQL",
         icon: "/svg/tech/mysql.svg"
    },
    {
         title: "JAVA",
         icon: "/svg/tech/java.svg"
    },
    {
         title: "SCRUM",
         icon: "/svg/tech/scrum.svg"
    },
    {
         title: "GITHUB",
         icon: "/svg/tech/github.svg"
    },
    {
         title: "JIRA",
         icon: "/svg/tech/jira.svg"
    },
]
---


<div class="carousel-container">
     <ul class="carousel-track">
       {TECHNOLOGIES.concat(TECHNOLOGIES).map((t) => (
         <li class="carousel-item">  
           <TechItem {...t}/>          
         </li>  
       ))}
     </ul>
</div>
   
 <style>
   /* Contenedor principal del carrusel */
   .carousel-container {
     width: 100%;
     overflow: hidden;
     position: relative;
   }
   
   /* Pista del carrusel */
   .carousel-track {
     display: flex;
     gap: 2rem;
     animation: scroll 50s linear infinite;
     width: max-content; /* Asegura que la lista sea suficientemente ancha */
   }
   
   /* Elementos individuales */
   .carousel-item {
     display: flex;
     align-items: center;
     justify-content: center;
     min-width: 100px; /* Ajusta el tamaño de cada ítem según necesites */
   }
   
   /* Animación infinita */
   @keyframes scroll {
     from {
       transform: translateX(0);
     }
     to {
       transform: translateX(-50%);
     }
   }
</style>