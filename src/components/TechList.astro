
---
import TechItem from './TechItem.astro';

const TECHNOLOGIES = [
    {
         title: "HTML",
         icon: "/svg/logoHTML.svg"
    },
    {
         title: "CSS",
         icon: "/svg/logoCSS.svg"
    },
    {
         title: "JAVASCRIPT",
         icon: "/svg/logoJS.svg"
    },
    {
         title: "TYPESCRIPT",
         icon: "/svg/logoTypescript.svg"
    },
    {
         title: "ASTRO",
         icon: "/svg/logoAstro.svg"
    },
    {
         title: "REACT",
         icon: "/svg/logoReact.svg"
    },
    {
         title: "TAILWINDCSS",
         icon: "/svg/logoTailwind.svg"
    },
    {
         title: "MYSQL",
         icon: "/svg/logoMYSQL.svg"
    },
    {
         title: "JAVA",
         icon: "/svg/logoJava.svg"
    },
    {
         title: "SCRUM",
         icon: "/svg/logoSCRUM.svg"
    },
    {
         title: "GITHUB",
         icon: "/svg/logoGITHUB.svg"
    },
    {
         title: "JIRA",
         icon: "/svg/logoJira.svg"
    },
]
---


<div class="carousel-container">
     <ul class="carousel-track">
       {TECHNOLOGIES.concat(TECHNOLOGIES).map((t) => (
         <li class="carousel-item">  
           <TechItem {...t}/>          
         </li>  
       ))}
     </ul>
</div>
   
 <style>
   /* Contenedor principal del carrusel */
   .carousel-container {
     width: 100%;
     overflow: hidden;
     position: relative;
   }
   
   /* Pista del carrusel */
   .carousel-track {
     display: flex;
     gap: 2rem;
     animation: scroll 50s linear infinite;
     width: max-content; /* Asegura que la lista sea suficientemente ancha */
   }
   
   /* Elementos individuales */
   .carousel-item {
     display: flex;
     align-items: center;
     justify-content: center;
     min-width: 100px; /* Ajusta el tamaño de cada ítem según necesites */
   }
   
   /* Animación infinita */
   @keyframes scroll {
     from {
       transform: translateX(0);
     }
     to {
       transform: translateX(-50%);
     }
   }
</style>