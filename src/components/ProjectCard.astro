---
const { image, title, description, github, demo, technologies } = Astro.props;
---
<div class="flex flex-col justify-center items-center rounded h-[400px] md:h-[600px] p-4 gap-4 bg-white dark:bg-[#181818]/70 shadow-lg dark:shadow-white/10">
  
  <h3 class="font-bold text-2xl text-gray-800 dark:text-white text-center">{title}</h3>
  
  <img class="w-full max-w-[300px] md:max-h-[450px] object-cover rounded-lg" src={image} alt={title} loading="lazy" />
 
  <div class="flex flex-wrap gap-2 mt-2">
    {technologies.map((tech: unknown) => (
      <span class="text-sm text-gray-600 dark:text-gray-300 bg-gray-300 dark:bg-gray-600 py-1 px-3 rounded-full">
        {tech}
      </span>
    ))}
  </div>


  <p class="text-black dark:text-gray-200 text-base px-4 sm:px-6 md:px-10 text-center leading-relaxed hidden p md:block">
    {description}
  </p>

  <div class="flex justify-center gap-6 mt-6 w-full">
  
    <a href={github} target="_blank" rel="noopener noreferrer" 
      class="inline-flex items-center justify-center gap-2 text-black dark:text-white border border-black dark:border-white
      rounded-lg px-4 py-2 
      text-center transition duration-300 ease-in-out transform hover:scale-105">
      <span class="hidden sm:inline">Repositorio</span>
    </a>
    
    {demo && demo !== "" && (
      <a href={demo} target="_blank" rel="noopener noreferrer" 
        class="inline-flex items-center justify-center gap-2 text-black dark:text-white border border-black dark:border-white
         rounded-lg px-4 py-2 
        text-center transition duration-300 ease-in-out transform hover:scale-105">
        <span class="hidden sm:inline">Demo</span>
      </a>
    )}
  
  </div>
  
</div>
