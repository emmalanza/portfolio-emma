---
const { image, title, description, github, demo, technologies } = Astro.props;
---
<div class="flex flex-col justify-center items-center rounded h-[400px] md:h-[650px] p-4 gap-4 bg-white dark:bg-[#181818]/70 shadow-lg dark:shadow-white/10">
  
  <h3 class="font-bold text-xl text-gray-800 dark:text-white text-center">{title}</h3>
  
  <img class="w-full max-w-[200px] md:max-h-[350px] object-cover rounded-lg" src={image} alt={title} loading="lazy" />
  
  <div class="flex flex-wrap gap-2 mt-2">
    {technologies.map((tech: unknown) => (
      <span class="text-sm text-gray-500 dark:text-gray-300 bg-gray-300 dark:bg-gray-600/70 py-1 px-2 rounded-full">
        {tech}
      </span>
    ))}
  </div>


  <p class="text-gray-700 dark:text-gray-200 text-base px-4 sm:px-6 md:px-10 text-center leading-relaxed hidden md:block">
    {description}
  </p>

  <div class="flex justify-center gap-6 mt-6 w-full">
  
    <a href={github} target="_blank" rel="noopener noreferrer" 
      class="inline-flex items-center justify-center gap-2 text-white hover:bg-gray-600 rounded-lg px-4 py-2 
      text-center transition duration-300 ease-in-out transform hover:scale-105 bg-gray-300 dark:bg-transparent">
      <img src="/svg/logoGITHUB.svg" class="w-8 h-8" alt="GitHub logo">
      <span class="hidden sm:inline">Repo de GitHub</span>
    </a>
    
    {demo && demo !== "" && (
      <a href={demo} target="_blank" rel="noopener noreferrer" 
        class="inline-flex items-center justify-center gap-2 text-white hover:bg-gray-600 rounded-lg px-4 py-2 
        text-center transition duration-300 ease-in-out transform hover:scale-105 bg-gray-300 dark:bg-transparent">
        <span class="hidden sm:inline">Demo</span>
        <img src="/svg/cursor-click.svg" class="w-8 h-8" alt="Cursor click icon">
      </a>
    )}
  
  </div>
  
  
</div>
