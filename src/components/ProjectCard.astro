---
const { title, description, github, demo, technologies } = Astro.props;
---

<div class="flex flex-col justify-center items-center gap-4 border border-gray-400 dark:border-gray-600 h-[200px] sm:h-[300px] py-6  shadow-md dark:shadow-white/10 transition-all duration-300">

  <div class="flex items-center justify-center w-full gap-4">
    <a href={github} target="_blank" rel="noopener noreferrer"
    class="hover:scale-110 hover:opacity-80 transition-transform duration-200"
    title="Repositorio en GitHub">
      <img class="w-8" src="/svg/tech/github.svg" alt="GitHub" />
    </a>
    <h3 class="font-bold text-2xl text-gray-800 dark:text-white text-center">{title}</h3>
  </div>

  <div class="flex flex-wrap justify-center gap-2">
    
    {technologies.map((tech: unknown) => (
      <span class="text-xs uppercase tracking-wide font-semibold text-yellow dark:text-bright-yellow/80 border-b-2 border-yellow dark:border-bright-yellow/80 px-2">
        {tech}
      </span>
    ))}
  </div>

  <p class="text-black dark:text-gray-200 text-base text-center leading-relaxed hidden sm:block px-2 sm:px-6">
    {description}
  </p>
  
    {demo && demo !== "" && (
      <a href={demo} target="_blank" rel="noopener noreferrer"
         class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200 hover:scale-110 transition transform duration-200"
         title="Ver demo del proyecto">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        <span class="underline underline-offset-4">Demo</span>
      </a>
    )}
  
</div>
