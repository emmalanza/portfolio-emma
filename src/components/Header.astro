---
const navItems = [
    {
        title: "Experiencia",
        url: "#experiencia",
        target: "_self"
    }, 
    {
        title: "Educación",
        url: "#educacion",
        target: "_self"
    }, 
    {
        title: "Certificaciones",
        url: "#certificaciones",
        target: "_self"
    }, 
    {
        title: "Tecnologías",
        url: "#tecnologias",
        target: "_self"
    }, 
    {
        title: "Sobre mi",
        url: "#sobreMi",
        target: "_self"
    }, 
    {
        title: "Contacto",
        url: "mailto:emmalanza@hotmail.com",
        target: "_blank"
    }
]

let menuOpen = false; // Variable para manejar el estado del menú
---

<header class="fixed top-0 z-10 flex justify-between items-center md:justify-center p-5 md:p-0 w-full">

    <!-- Botón de menú hamburguesa -->
    <button 
    id="hamburgerButton" 
    class="md:hidden flex flex-col space-y-1 z-30"
    aria-label="Abrir menú"
    >
    <span class="block w-6 h-0.5 dark:bg-white bg-black"></span>
    <span class="block w-6 h-0.5 dark:bg-white bg-black"></span>
    <span class="block w-6 h-0.5 dark:bg-white bg-black"></span>
    </button>



    <!-- Menú -->
    <nav id="navMenu"
    class={`md:flex ${menuOpen ? "block" : "hidden"} 
    absolute flex flex-col 
    pt-28 md:pt-0 md:mt-4
    top-0 left-0 right-0 backdrop-blur-xl h-screen 
    md:block md:flex-row md:gap-0 md:static md:h-auto 
    md:bg-transparent md:backdrop-blur-none transition-all md:rounded-full`}>

    {
        navItems.map((link) => (
            <a class="mt-4 mb-4 md:mt-0 md:mb-0
            px-2 py-2 transition hover:text-pink-light text-sm font-thin"
            href={link.url} target={link.target} rel="noopener noreferrer">
                {link.title}
            </a>
        ))

    }
    </nav>

    <button id="toggle-theme" 
    class="rounded-full md:absolute 
    md:right-9 md:top-3 
    backdrop-blur-sm ">
      <img src="" alt="Toggle icon">
    </button>



</header>

<script>
 
  const hamburgerButton = document.getElementById('hamburgerButton');
  const navMenu = document.getElementById('navMenu');

  if(navMenu && hamburgerButton){

    const navLinks: NodeListOf<HTMLAnchorElement> = navMenu.querySelectorAll('a');
    navLinks.forEach(link => {
        link.addEventListener('click', () => {
        navMenu.classList.add('hidden'); 
        });
    });

    hamburgerButton.addEventListener('click', () => {
    navMenu.classList.toggle('hidden'); 
    });

  } 
 
  const toggleButton = document.getElementById("toggle-theme");
  const body = document.body;
  const bgLight = document.getElementById('bg-light');
  const bgDark = document.getElementById('bg-dark');

  
  if(toggleButton){

    function switchTheme() {
        if(bgLight && bgDark && toggleButton){
            const currentTheme = localStorage.getItem("theme");
            if (currentTheme === "dark") {
            bgLight.classList.add("hidden");
            bgDark.classList.remove("hidden");
            body.classList.add("dark");
            body.style.background = "#0a0a0a";
            body.style.color = "#ffffff";
            const img = toggleButton.querySelector('img');
            if(img)
            img.src = "/svg/sun.svg";
           const banner = document.getElementById('banner') as HTMLImageElement;
           if(banner)
           banner.src = "/img/banner-dark.png";
          } else {
            bgLight.classList.remove("hidden");
            bgDark.classList.add("hidden");
            body.classList.remove("dark");
            body.style.background = "#ffffff";
            body.style.color = "#0a0a0a";
            const img = toggleButton.querySelector('img');
            if(img)
            img.src = "/svg/moon.svg";
            const banner = document.getElementById('banner') as HTMLImageElement;
            if(banner)
            banner.src = "/img/banner-light.png";
          }
        }
      }
    switchTheme();

    toggleButton.addEventListener("click", () => {
      body.classList.toggle("dark"); 
      const newTheme = body.classList.contains("dark") ? "dark" : "light";
      localStorage.setItem("theme", newTheme);
      switchTheme();
    });  

  }


</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
        0%{
            
        }
        to {
           @apply shadow-lg ring-1 backdrop-blur ring-pink-100/10; 
        }
    }

  /* Menú en móviles */
  nav {
    transition: transform 0.3s ease-in-out;
  }

</style>
