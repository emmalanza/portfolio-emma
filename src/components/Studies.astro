---
import StudiesItem from './ListItem.astro';

const STUDIES = [
    {
        date: "2024 - 2025",
        title: "BOOTCAMP DESARROLLO WEB FULL STACK",
        description: {
            'Frontend': "HTML5, CSS3, JavaSript, TypeScript, React, TailwindCSS",
            'Backend': "Node.js, Java, SpringBoot, MySQL",
            'Metodologías': "Agile, Scrum",
            'Herramientas': "Git, GitHub, Jira, VSCode, Figma, Canva, Notion"
        }
        ,
    },
    {
        date: "2024",
        title: "CP - DESARROLLO DE APLICACIONES WEB - 600H",
        description: "Programación web en entornos cliente-servidor / Implantación de aplicaciones web en entornos internet, intranet y extranet.",
    },
    {
        date: "2018 / 2020",
        title: "FP II DESARROLLO DE APLICACIONES MULTIPLATAFORMA",
        description: "Desarrollar aplicaciones multiplataforma con acceso a bases de datos utilizando lenguajes, librerías y herramientas adecuados a las especificaciones.",
    },
    {
        date: "2016 / 2018",
        title: "FP II AUXILIAR ADMINISTRATIVO Y SECRETARIADO",
        description: "Administración de sistemas de información y archivos, gestión de documentos, control y desarrollo de los recursos humanos.",
    },
]
---


<ol class="relative border-s border-gray-200 ml-3">
    {
        STUDIES.map(s => (
        <li class="mb-10 ms-6">  
            <StudiesItem {...s}/>          
        </li>  
        ))
    }                  
            
</ol>

