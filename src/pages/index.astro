---
import Layout from '../layouts/Layout.astro';
import SectionContainer from '../components/SectionContainer.astro'
import Badge from '../components/Badge.astro';
import SocialPill from '../components/SocialPill.astro';
import Studies from '../components/Studies.astro';
import WorkExperience  from '../components/WorkExperience.astro';
import Certifications from '../components/Certifications.astro';
import TechList from '../components/TechList.astro';
import AboutMe from '../components/AboutMe.astro';
import Separator from '../components/Separator.astro';
import StudiesIcon from '../icons/Studies.astro';
import ExperienceIcon from '../icons/Experience.astro';
import CertificationsIcon from '../icons/Certifications.astro';
import TechIcon from '../icons/Tech.astro';
import AboutMeIcon from '../icons/AboutMe.astro';
import GitHubIcon from '../icons/Github.astro';
import LinkedInIcon from '../icons/LinkedIn.astro';
import EmailIcon from '../icons/Email.astro';

import "aos/dist/aos.css"; 

---

<Layout title="Portfolio de Emma - Desarrolladora y Programadora Full Stack"
		description='Desarrolladora Full Stack en crecimiento'>

	<script>
		import { aosInit } from "../js/aos";
		aosInit();
		document.addEventListener("astro:after-swap", aosInit);
	</script>

	<main>

		<SectionContainer class="pt-24 md:pt-40 md:pb-40 pb-24">

			<img class="rounded-full w-20 h-20 mb-4"
			src="/img/YOP.jpeg" alt="Una foto de Emma" data-aos="zoom-in" data-aos-delay="300">

			<h1 class="text-3xl pb-6
			md:text-4xl
			lg:text-5xl font-bold flex flex-col md:flex-row gap-4 lg:pb-10"  data-aos="zoom-in" data-aos-delay="200" >
				Hola 🤓 soy Emma
				<a href="https://www.linkedin.com/in/emma-lanza-089861150/" 
				target="_blank" rel="noopener noreferrer"
				class="flex md:justify-center md:items-center"> 
					<Badge>Disponible para trabajar </Badge>
				</a>
			</h1>

			<h2 class="text-wrap max-w-[700px] opacity-80">
				<span class="text-pink-300/90 text-xl md:text-2xl">Desarrolladora Full Stack en crecimiento 🌱</span>
				<br>
				<span class="text-md md:text-lg">De Asturias, Epaña.</spanc>
			</h2>

			<nav class="flex flex-col sm:flex-row flex-wrap gap-4 mt-8 ">
				<SocialPill href="https://www.linkedin.com/in/emma-lanza-089861150/">
					<LinkedInIcon/>
					LinkedIn
				</SocialPill>
				<SocialPill href="https://github.com/emmalanza">
					<GitHubIcon/>
					GitHub
				</SocialPill>
				<SocialPill href="mailto:emmalanza@hotmail.com">
					<EmailIcon/>
					emmalanza@hotmail.com
				</SocialPill>
				
		
			</nav>

		</SectionContainer>

		<SectionContainer id="experiencia" class="pb-20 relative">
			<div class="hidden lg:block section-title">EXPERIENCIA</div>
		
			<h3 class="text-xl
			lg:text-2xl font-semibold mb-6
			flex items-center gap-x-2">
				<ExperienceIcon/>
				Experiencia
			</h3>
			<WorkExperience />

		</SectionContainer>

		<SectionContainer id="educacion" class="pb-20 relative">
			<div class="hidden lg:block section-title">EDUCACIÓN</div>
		
			<h3 class="text-xl
			lg:text-2xl font-semibold mb-6
			flex items-center gap-x-2">
				<StudiesIcon/>
				Educación
			</h3>
			<Studies />

		</SectionContainer>

		<SectionContainer id="certificaciones" class="pb-20 relative">
			<div class="hidden lg:block section-title">CERTIFICACIONES</div>
		
			<h3 class="text-xl
			lg:text-2xl font-semibold mb-6
			flex items-center gap-x-2">
				<CertificationsIcon/>
				Certificaciones
			</h3>
			<Certifications />

		</SectionContainer>

		<SectionContainer id="tecnologias" class="pb-20 relative">
			
			<h3 class="text-xl
			lg:text-2xl font-semibold mb-6
			flex items-center gap-x-2">
				<TechIcon/>
				Tecnologías
			</h3>
			<TechList />

		</SectionContainer>

		<SectionContainer id="sobreMi" class="pb-20 relative">

			<h3 class="text-xl
			lg:text-2xl font-semibold mb-6
			flex items-center gap-x-2">
				<AboutMeIcon/>
				Sobre mi
			</h3>
			<AboutMe />

		</SectionContainer>
		
	</main>
</Layout>
 

 <style>
	.section-title {
		font-size: 7rem;
		font-weight: bold;
		color: rgba(255, 255, 255, 0.02);
		text-align: center;
		position: absolute;
		top: -50px;
		left: 50%;
		transform: translateX(-50%);
		z-index: -1;
	}

 </style>