---
import Layout from '../layouts/Layout.astro';
import SectionContainer from '../components/SectionContainer.astro'
import Badge from '../components/Badge.astro';
import SocialPill from '../components/SocialPill.astro';
import Studies from '../components/Studies.astro';
import WorkExperience  from '../components/WorkExperience.astro';
import Certifications from '../components/Certifications.astro';
import TechList from '../components/TechList.astro';
import AboutMe from '../components/AboutMe.astro';
import GitHubIcon from '../icons/Github.astro';
import LinkedInIcon from '../icons/LinkedIn.astro';
import EmailIcon from '../icons/Email.astro';

import "aos/dist/aos.css"; 
import ProjectsList from '../components/ProjectsList.astro';

---

<Layout title="Portfolio de Emma - Desarrolladora y Programadora Full Stack"
		description='Desarrolladora Full Stack'>

	<script>
		import { aosInit } from "../js/aos";
		aosInit();
		document.addEventListener("astro:after-swap", aosInit);
	</script>

	<SectionContainer class="mt-20 mb-28">

		<div  data-aos="flip-left" data-aos-delay="200">
			<img id="banner" src="/img/banner.png" alt="Banner" loading="lazy" class="relative w-full">
			<img class="absolute md:-bottom-16 md:left-10 -bottom-8 left-2
			md:border-4 border-2 border-white
			rounded-full md:w-36 md:h-36 w-20 h-20"
			src="/img/YOP.jpeg" alt="Una foto de Emma" loading="lazy">
			<div
			class="absolute md:-bottom-12 md:right-10 -bottom-10 right-5"> 
				<Badge/> 
			</div>
		</div>

		<div class="mt-20 md:ml-10" data-aos="flip-down" data-aos-delay="600">
			<h1 class="text-3xl md:text-4xl ml-5 md:ml-0 font-bold">
				Emma Lanza
			</h1>
			<h2 class="text-wrap opacity-80 ml-5 md:ml-0">
				<span class="text-pink-dark text-lg">Desarrolladora Full Stack en crecimiento 🌱</span>
				<br>
				<span class="text-md">De Asturias, España.</spanc>
			</h2>

			<nav class="flex flex-col sm:flex-row flex-wrap gap-4 mt-8 ">
				<SocialPill href="https://www.linkedin.com/in/emma-lanza-m/">
					<LinkedInIcon/>
					LinkedIn
				</SocialPill>
				<SocialPill href="https://github.com/emmalanza">
					<GitHubIcon/>
					GitHub
				</SocialPill>
				<SocialPill href="mailto:emmalanza@hotmail.com">
					<EmailIcon/>
					emmalanza@hotmail.com
				</SocialPill>
				
			</nav> 

		</div>

	</SectionContainer>

	<main class="md:ml-10">

		<SectionContainer id="proyectos" class="pb-32 relative">
			<div class="font-banger hidden lg:block section-title">PROYECTOS</div>
		
			<h3 class="text-xl
			md:text-4xl font-semibold mb-6
			flex items-center gap-x-2">
				<img src="/svg/projects.svg" alt="Icono" 
				style="mask-image: linear-gradient(to bottom, black 10%, transparent 100%);">
				Mis Proyectos
			</h3>
			<ProjectsList />

		</SectionContainer>

		<SectionContainer id="experiencia" class="pb-32 relative">
			<div class="font-banger hidden lg:block section-title">EXPERIENCIA</div>
		
			<h3 class="text-xl
			md:text-4xl font-semibold mb-6
			flex items-center gap-x-2">
				<img src="/svg/work.svg" alt="Icono" 
				style="mask-image: linear-gradient(to bottom, black 10%, transparent 100%);">
				Experiencia
			</h3>
			<WorkExperience />

		</SectionContainer>

		<SectionContainer id="educacion" class="pb-32 relative">
			<div class="font-banger hidden lg:block section-title">EDUCACIÓN</div>
		
			<h3 class="text-xl
			md:text-4xl font-semibold mb-6
			flex items-center gap-x-2">
				<img src="/svg/studies.svg" alt="Icono" 
				style="mask-image: linear-gradient(to bottom, black 10%, transparent 100%);">
				Educación
			</h3>
			<Studies />

		</SectionContainer>

		<SectionContainer id="certificaciones" class="pb-32 relative">
			<div class="font-banger hidden lg:block section-title">CERTIFICACIONES</div>
		
			<h3 class="text-xl
			md:text-4xl font-semibold mb-6
			flex items-center gap-x-2">
				<img src="/svg/certificate.svg" alt="Icono" 
				style="mask-image: linear-gradient(to bottom, black 10%, transparent 100%);">
				Certificaciones
			</h3>
			<Certifications />

		</SectionContainer>

		<SectionContainer id="tecnologias" class="pb-32 relative">
			<div class="font-banger hidden lg:block section-title">TECNOLOGÍAS</div>
			<h3 class="text-xl
			md:text-4xl font-semibold mb-6
			flex items-center gap-x-2">
				<img src="/svg/tech.svg" alt="Icono" 
				style="mask-image: linear-gradient(to bottom, black 10%, transparent 100%);">
				Tecnologías
			</h3>
			<TechList />

		</SectionContainer>

		<SectionContainer id="sobreMi" class="pb-32 relative">
			<div class="font-banger hidden lg:block section-title">SOBRE MI</div>
			<h3 class="text-xl
			md:text-4xl font-semibold mb-6
			flex items-center gap-x-2">
				<img src="/svg/yoop.svg" alt="Icono" 
				style="mask-image: linear-gradient(to bottom, black 10%, transparent 100%);">
				Sobre mi
			</h3>
			<AboutMe />
		</SectionContainer>
		
	</main>
	
</Layout>
 

 <style>
	.section-title {
		font-size: 10rem;
		color: rgba(150, 150, 150, 0.1);
		text-align: center;
		position: absolute;
		top: -110px;
		left: 50%;
		transform: translateX(-50%);
		z-index: -1;
		white-space: nowrap;
		filter: blur(0.5px); 
	}
 </style>